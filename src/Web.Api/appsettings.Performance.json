{
  "PolymorphicReferenceAudit": {
    "Enabled": false
  },
  "PerformanceMonitoring": {
    "SlowHandlerThresholdMilliseconds": 250
  },
  "DatabasePerformance": {
    "Pooling": true,
    "MaxPoolSize": 20,
    "MinPoolSize": 0,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 25,
    "LockTimeoutSeconds": 20,
    "RequestTimeoutSeconds": 30,
    "KeepAliveSeconds": 0,
    "CancellationTimeoutSeconds": 2,
    "ApplicationReplicaCount": 1,
    "DatabaseConnectionBudget": 100,
    "HealthCheckConnectionReserve": 1,
    "MigrationConnectionReserve": 1,
    "EndpointMode": "Auto"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
