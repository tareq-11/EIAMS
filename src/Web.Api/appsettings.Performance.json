{
  "PolymorphicReferenceAudit": {
    "Enabled": false
  },
  "PerformanceMonitoring": {
    "SlowHandlerThresholdMilliseconds": 250
  },
  "DatabasePerformance": {
    "CommandTimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
