{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowInSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Numbering": {
    "SequencePadding": 6,
    "Separator": "-",
    "MaxReferenceNumberLength": 100,
    "ReceivingCode": "RCV",
    "IssueCode": "ISS",
    "TransferCode": "TRF",
    "AdjustmentCode": "ADJ",
    "OpeningCode": "OPN",
    "ReturnCode": "RET"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
