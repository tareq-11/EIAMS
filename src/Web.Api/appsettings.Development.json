{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=neondb;Username=clean_architecture;Password=local_dev_password"
  },
  "DatabaseMigrations": {
    "ApplyOnStartup": false
  },
  "AttachmentStorage": {
    "MalwareScan": {
      "Policy": "Disabled"
    }
  },
  "DatabasePerformance": {
    "MaxPoolSize": 10,
    "MinPoolSize": 0,
    "ConnectionTimeoutSeconds": 5,
    "ApplicationReplicaCount": 1,
    "DatabaseConnectionBudget": 30,
    "EndpointMode": "Auto"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://localhost:8081" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  }
}
