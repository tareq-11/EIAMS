{
  "DatabaseMigrations": {
    "ApplyOnStartup": true
  },
  "AttachmentStorage": {
    "MalwareScan": {
      "Policy": "Disabled"
    },
    "Local": {
      "RootPath": "../../attachment-storage"
    }
  },
  "DatabasePerformance": {
    "MaxPoolSize": 10,
    "MinPoolSize": 0,
    "ConnectionTimeoutSeconds": 5,
    "ApplicationReplicaCount": 1,
    "DatabaseConnectionBudget": 30,
    "EndpointMode": "Auto"
  },
  "Jwt": {
    "Issuer": "EIAMS.Api",
    "Audience": "EIAMS.Client",
    "ExpirationInMinutes": 60,
    "RequireHttpsMetadata": false
  },
  "BootstrapAdministrator": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
