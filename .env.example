# EIAMS backend - local development environment template.
#
# Copy to `.env` (git-ignored) and fill in, or supply the same keys through
# ASP.NET Core user-secrets, which takes precedence over appsettings.*.json:
#
#   dotnet user-secrets --project src/Web.Api set "ConnectionStrings:Database" "Host=localhost;Port=5432;Database=eiams;Username=postgres;Password=<pw>;Timeout=15"
#   dotnet user-secrets --project src/Web.Api set "Jwt:Secret" "<>=32 bytes>"
#
# NO REAL SECRET MAY BE COMMITTED TO THIS REPOSITORY.
# `src/Web.Api/appsettings.Development.json` intentionally ships without these
# values so that startup fails fast with a clear configuration error rather
# than silently running on a published credential.

# --- Required -------------------------------------------------------------
# PostgreSQL connection. Required; the app refuses to start without it.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=eiams;Username=postgres;Password=postgres;Include Error Detail=true;Timeout=15

# HMAC-SHA256 JWT signing key. Required; must be at least 32 bytes.
# Generate one with:  openssl rand -base64 48
Jwt__Secret=CHANGE_ME_AT_LEAST_32_BYTES

# --- Optional: bootstrap administrator ------------------------------------
# Seeding is refused against a non-empty database that already has an active
# SYSTEM_ADMIN, so this only runs on a fresh database.
BootstrapAdministrator__Enabled=false
BootstrapAdministrator__Email=admin@example.invalid
BootstrapAdministrator__Username=admin
BootstrapAdministrator__FirstName=Local
BootstrapAdministrator__LastName=Administrator
BootstrapAdministrator__Password=CHANGE_ME

# --- Must stay empty -------------------------------------------------------
# Cross-origin browser access is not supported in any environment. The API
# refuses to start if either value is non-empty. Browsers must reach the API
# through the UI's same-origin /api/v1 dev proxy.
Cors__AllowedOrigins=
Authentication__RefreshTokenTransport__AllowedCookieOrigins=
